app-id: io.github.jrnovaex.azura
runtime: org.freedesktop.Platform
runtime-version: '24.08'
sdk: org.freedesktop.Sdk
command: azura

finish-args:
  # GTK needs to talk to the display server.
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
  # Azura launches real programs: applications found through the .desktop
  # files in the XDG data directories, and shell commands in a terminal.
  - --talk-name=org.freedesktop.Flatpak
  # The icon cache and the sessions file live under XDG_DATA_HOME.
  - --env=XDG_DATA_HOME=/app/share/azura/data

modules:
  - name: azura
    buildsystem: simple
    build-commands:
      # Not `--offline`: the SDK has no vendored crates and GPUI's tree is
      # large, so the sources have to be fetched first. `--locked` keeps
      # Cargo.lock honest, so a build cannot silently pick up a new version.
      - cargo fetch --locked
      - cargo build --release --offline
      - install -Dm755 target/release/azura /app/bin/azura
      - install -Dm644 packaging/linux/azura.desktop
          /app/share/applications/io.github.jrnovaex.azura.desktop
      - install -Dm644 crates/azura/assets/icons/azura.svg
          /app/share/icons/hicolor/scalable/apps/io.github.jrnovaex.azura.svg
      - install -Dm644 crates/azura/assets/logo/azura.png
          /app/share/icons/hicolor/256x256/apps/io.github.jrnovaex.azura.png
    sources:
      - type: dir
        path: ../..